{
  "name": "runforacause",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack monorepo launcher — runs FastAPI backend + Next.js frontend with one command.",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c \"blue,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "setup": "powershell -ExecutionPolicy Bypass -File start.ps1 -Setup -Seed",
    "seed": "cd backend && .venv\\Scripts\\python.exe -m app.seed",
    "migrate": "cd backend && .venv\\Scripts\\python.exe -m alembic upgrade head",
    "stop": "powershell -ExecutionPolicy Bypass -File stop.ps1",
    "reset": "powershell -ExecutionPolicy Bypass -File start.ps1 -Reset -Setup",
    "test": "concurrently -n backend,frontend -c \"blue,green\" \"npm:test:backend\" \"npm:test:frontend\"",
    "test:backend": "cd backend && .venv\\Scripts\\python.exe -m pytest tests/ -p no:warnings",
    "test:frontend": "cd frontend && npm test",
    "lint": "concurrently -n backend,frontend -c \"blue,green\" \"npm:lint:backend\" \"npm:lint:frontend\"",
    "lint:backend": "cd backend && .venv\\Scripts\\ruff.exe check app/",
    "lint:frontend": "cd frontend && npm run lint && npx tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
