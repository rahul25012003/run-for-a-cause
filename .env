# Local native run (no Docker)
APP_ENV=development
DEBUG=true
SECRET_KEY=local-dev-secret-key-min-32-chars-long-please-change-me

# Postgres on localhost (not the docker hostname)
DATABASE_URL=postgresql+asyncpg://runforacause:localpassword@localhost:5432/runforacause

# Redis is not required for M1 — leave default; nothing will try to connect
REDIS_URL=redis://localhost:6379/0

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Razorpay — leave dummies; the SDK falls back to mock orders for the demo
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

EMAIL_PROVIDER=console
RESEND_API_KEY=
FROM_EMAIL=noreply@runforacause.in
FROM_NAME=RunForACause

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=runforacause-uploads
S3_PUBLIC_URL=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

PLATFORM_FEE_PERCENT=3.0
SETTLEMENT_WINDOW_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
