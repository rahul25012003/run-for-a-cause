# ──────────────────────────────────────────────────────────────────────────────
# RunForACause — Frontend Environment Variables
# Copy to .env.local for local dev. In production set these in your host.
# ──────────────────────────────────────────────────────────────────────────────

# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public domain of this Next.js app — used for OG images, share links, Strava callback
NEXT_PUBLIC_SITE_URL=https://runforacause.in

# Razorpay publishable key (rzp_live_... in production, rzp_test_... in dev)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dummy
