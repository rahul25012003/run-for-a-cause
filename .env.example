# ===== Backend =====
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-min-32-chars-long-please

DATABASE_URL=postgresql+asyncpg://runforacause:localpassword@postgres:5432/runforacause
REDIS_URL=redis://redis:6379/0

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email — leave EMAIL_PROVIDER=console for dev (logs emails instead of sending)
EMAIL_PROVIDER=console
RESEND_API_KEY=
FROM_EMAIL=noreply@runforacause.in
FROM_NAME=RunForACause

# Storage (Cloudflare R2 or AWS S3) — optional for dev
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=runforacause-uploads
S3_PUBLIC_URL=

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Platform
PLATFORM_FEE_PERCENT=3.0
SETTLEMENT_WINDOW_DAYS=7

# CORS — comma-separated list (Pydantic parses JSON arrays too)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===== Optional integrations (services no-op when blank) =====
# APScheduler — only flip to 1 on ONE worker in production
ENABLE_SCHEDULER=0

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENVIRONMENT=development

# Anthropic — enables AI insights + AI impact draft (rule-based fallback otherwise)
ANTHROPIC_API_KEY=

# WhatsApp Business via Gupshup (D1)
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=

# SMS OTP via MSG91 (D6)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RFACAU

# Strava OAuth (C1) — register at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback

# ===== Frontend (set in frontend/.env.local) =====
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
